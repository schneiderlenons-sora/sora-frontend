# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local tooling
.claude/
.playwright-mcp/
/*.png
.github/

# Chaves de assinatura Android (Bubblewrap/TWA) — NUNCA versionar.
# A keystore de verdade fica FORA deste repo de propósito (ver comentário no
# CLAUDE.md sobre o build do app); isto é só uma rede de segurança.
*.keystore
*.jks

# Projeto Android gerado pelo Bubblewrap — o build de verdade vive em
# C:\Users\jenif\sora-android (fora deste repo, caminho ASCII-only por
# limitação do Android Gradle Plugin no Windows). Se `bubblewrap init` rodar
# aqui por engano de novo, isto impede o `git add -A` de arrastar um projeto
# Gradle inteiro (~dezenas de arquivos, nada a ver com o Next.js) pro commit.
/app/build.gradle
/app/src/
/.gradle/
/build.gradle
/gradle/
/gradle.properties
/gradlew
/gradlew.bat
/settings.gradle
/twa-manifest.json
/manifest-checksum.txt

<?xml version="1.0" encoding="utf-8"?>
<!-- Registro do widget "Cartão" (gerado por gerar-previas.cjs). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.forsora.app.widget.WidgetOpcoesActivity"
    android:description="@string/widget_cartao_descricao"
    android:initialLayout="@layout/widget_cartao"

<?xml version="1.0" encoding="utf-8"?>
<!-- Janela de opções de um widget (WidgetOpcoesActivity). Tela comum do
     Android, não RemoteViews: aqui vale qualquer componente. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="300dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_opcoes_titulo"
            android:textColor="@color/widget_texto"
            android:textSize="20sp" />

        <Switch
            android:id="@+id/widget_opcoes_valores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="48dp"
            android:text="@string/widget_opcoes_valores"
            android:textColor="@color/widget_texto"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_opcoes_valores_sub"
            android:textColor="@color/widget_texto2"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/widget_opcoes_secao_cartao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/widget_opcoes_cartao"
                android:textColor="@color/widget_texto2"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/widget_opcoes_cartoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/widget_opcoes_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/widget_texto2"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_opcoes_cancelar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_opcoes_cancelar"
                android:textAllCaps="false"
                android:textColor="@color/widget_texto2"
                android:textSize="15sp" />

            <Button
                android:id="@+id/widget_opcoes_salvar"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/widget_opcoes_salvar"
                android:textAllCaps="false"
                android:textColor="@color/widget_conectar_texto"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

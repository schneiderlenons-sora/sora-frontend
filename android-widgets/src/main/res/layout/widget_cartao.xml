<?xml version="1.0" encoding="utf-8"?>
<!-- "Cartão" (2x2): nome do cartão, fatura atual, quando fecha/vence e o aviso
     de atraso (só aparece quando há fatura atrasada). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_cartao_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/widget_tile_violeta"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/widget_ic_cartao" />

        <TextView
            android:id="@+id/widget_cartao_nome"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_texto"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_cartao_rotulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_texto2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_cartao_valor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:letterSpacing="-0.01"
        android:maxLines="1"
        android:textColor="@color/widget_texto"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_cartao_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/widget_texto2"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_cartao_atraso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginEnd="4dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ic_alerta_vermelho" />

        <TextView
            android:id="@+id/widget_cartao_atraso_txt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_vermelho"
            android:textSize="11.5sp" />
    </LinearLayout>
</LinearLayout>

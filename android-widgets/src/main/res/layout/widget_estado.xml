<?xml version="1.0" encoding="utf-8"?>
<!-- Estados comuns a todos os widgets: conectar, fora do plano e sem dados.
     O texto e o ícone vêm do BaseWidget.estado; o botão só no "conectar". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_estado_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:id="@+id/widget_estado_icone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_marca" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_estado_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/widget_texto"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_estado_texto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:lineSpacingExtra="1dp"
        android:maxLines="3"
        android:textColor="@color/widget_texto2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_estado_botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_botao_conectar"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="7dp"
        android:text="@string/widget_conectar_botao"
        android:textColor="@color/widget_conectar_texto"
        android:textSize="12.5sp"
        android:visibility="gone" />
</LinearLayout>

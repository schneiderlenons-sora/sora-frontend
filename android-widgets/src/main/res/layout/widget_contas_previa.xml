<?xml version="1.0" encoding="utf-8"?>
<!-- PRÉVIA da galeria (Próximas contas). Gerada a partir de widget_contas.xml:
     mexeu no layout, gere de novo. Os textos estão em values/widget_previa.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_contas_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fundo"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="108dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_contas_cabecalho"
            android:text="@string/widget_previa_contas_cabecalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_texto2"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_contas_qtd"
                android:text="@string/widget_previa_contas_qtd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_texto"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_contas_rotulo"
                android:text="@string/widget_previa_contas_rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_texto"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_contas_total"
            android:text="@string/widget_previa_contas_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_texto"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_contas_dia0"
                    android:text="@string/widget_previa_contas_dia0"
                    android:background="@drawable/widget_hoje"
                    android:textColor="@color/widget_hoje_texto"
                    android:textStyle="bold"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/widget_contas_ponto0"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_contas_dia1"
                    android:text="@string/widget_previa_contas_dia1"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_texto2"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/widget_contas_ponto1"
                    android:src="@drawable/widget_ponto_fixa"
                    android:visibility="visible"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_contas_dia2"
                    android:text="@string/widget_previa_contas_dia2"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_texto2"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/widget_contas_ponto2"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_contas_dia3"
                    android:text="@string/widget_previa_contas_dia3"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_texto2"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/widget_contas_ponto3"
                    android:src="@drawable/widget_ponto_fatura"
                    android:visibility="visible"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_contas_dia4"
                    android:text="@string/widget_previa_contas_dia4"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_texto2"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/widget_contas_ponto4"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_contas_dia5"
                    android:text="@string/widget_previa_contas_dia5"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_texto2"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/widget_contas_ponto5"
                    android:src="@drawable/widget_ponto_agendado"
                    android:visibility="visible"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_contas_dia6"
                    android:text="@string/widget_previa_contas_dia6"
                    android:layout_width="15dp"
                    android:layout_height="18dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_texto2"
                    android:textSize="10.5sp" />

                <ImageView
                    android:id="@+id/widget_contas_ponto6"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/widget_divisor"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/widget_contas_vazio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_check_marca" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/widget_nada_vence"
                android:textColor="@color/widget_texto"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_contas_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/widget_contas_linha0"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_contas_icone0"
                    android:src="@drawable/widget_ic_casa"
                    android:background="@drawable/widget_tile_cinza"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:padding="7dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_contas_titulo0"
                            android:text="@string/widget_previa_contas_titulo0"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/widget_contas_valor0"
                            android:text="@string/widget_previa_contas_valor0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_contas_alerta0"
                            android:visibility="visible"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_ic_alerta_vermelho" />

                        <TextView
                            android:id="@+id/widget_contas_sub0"
                            android:text="@string/widget_previa_contas_sub0"
                            android:textColor="@color/widget_vermelho"
                            android:textStyle="bold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_contas_linha1"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_contas_icone1"
                    android:src="@drawable/widget_ic_luz"
                    android:background="@drawable/widget_tile_ambar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:padding="7dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_contas_titulo1"
                            android:text="@string/widget_previa_contas_titulo1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/widget_contas_valor1"
                            android:text="@string/widget_previa_contas_valor1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_contas_alerta1"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_ic_alerta_vermelho"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_contas_sub1"
                            android:text="@string/widget_previa_contas_sub1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto2"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_contas_linha2"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_contas_icone2"
                    android:src="@drawable/widget_ic_cartao"
                    android:background="@drawable/widget_tile_violeta"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:importantForAccessibility="no"
                    android:padding="7dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/widget_contas_titulo2"
                            android:text="@string/widget_previa_contas_titulo2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/widget_contas_valor2"
                            android:text="@string/widget_previa_contas_valor2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/widget_contas_alerta2"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="4dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/widget_ic_alerta_vermelho"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/widget_contas_sub2"
                            android:text="@string/widget_previa_contas_sub2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_texto2"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_contas_mais"
                android:text="@string/widget_previa_contas_mais"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="37dp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:textColor="@color/widget_texto2"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
